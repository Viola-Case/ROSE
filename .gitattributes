# Normalize all text files to LF in the repository, regardless of the
# machine's core.autocrlf setting (repo is used across multiple systems
# and git clients). Binary files are auto-detected and left untouched.
* text=auto

# Shell scripts must keep LF in the working tree on every platform: a CRLF
# checkout makes the shebang line read "/bin/sh\r", which the kernel reports as
# "bad interpreter: No such file or directory".
*.sh text eol=lf
