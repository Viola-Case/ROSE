{
  "name": "rose",
  "version": "0.0.2",
  "homepage": "https://github.com/Viola-Case/ROSE",
  "license": "BSD-3-Clause",
  "description": "Radical Open Software Engine",
  "builtin-baseline": "a0b1c8d3a477c1cb4813d8e127a56961707ca42b",
  "dependencies": [
    {
      "name": "sdl3",
      "features": ["vulkan"],
      "platform": "windows"
    },
    {
      "name": "sdl3",
      "features": [ "vulkan", "x11", "wayland"],
      "platform": "linux"
    },
    {
      "name": "sdl3-mixer",
      "features": [
        "libflac",
        "libvorbis",
        "mpg123",
        "opusfile",
        "wavpack"
      ]
    },
    {
      "name": "sdl3-ttf",
      "features": ["svg"]
    },
    {
      "name": "sdl3-image",
      "features": [
        "jpeg",
        "png",
        "tiff",
        "webp"
      ]
    },
    {
      "name": "imgui",
      "features": [
        "sdl3-binding", "opengl3-binding", "vulkan-binding", "sdl3-renderer-binding"
      ]
    },
    {
      "name": "glad",
      "features": ["gl-api-45"]
    },
    {
      "name": "nlohmann-json",
      "features": []
    },
    {
      "name": "cli11"
    },
    {
      "name": "mimalloc",
      "features": ["override"]
    }

  ]
}
