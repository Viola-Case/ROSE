{
  "name": "rose",
  "version": "0.0.1",
  "homepage": "https://github.com/Viola-Case/ROSE",
  "license": null,
  "description": "Radical Open Software Engine",
  "builtin-baseline": "b5d1a94fb7f88fd835e360fd23a45a09ceedbf48",
  "dependencies": [
    {
      "name": "sdl3",
      "features": [
        "vulkan"
      ]
    },
    {
      "name": "sdl3-mixer",
      "features": [
        "libflac",
        "libvorbis",
        "mpg123",
        "opusfile",
        "wavpack"
      ]
    },
    {
      "name": "sdl3-ttf",
      "features": [
        "svg"
      ]
    },
    {
      "name": "sdl3-image",
      "features": [
        "jpeg",
        "png",
        "tiff"
      ]
    },
    {
      "name": "imgui",
      "features": [
        "sdl3-binding", "opengl3-binding", "vulkan-binding", "sdl3-renderer-binding"
      ]
    },
    {
      "name": "glad",
      "features": [
        "gl-api-45"
      ]
    },
    {
      "name": "spirv-cross"
    },
    {
      "name": "glslang",
      "features": [
        "opt",
        "tools"
      ]
    },
    {
      "name": "nlohmann-json",
      "features": []
    }

  ]
}
