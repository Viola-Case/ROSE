{
  "name": "rose",
  "version": "0.0.1",
  "homepage": "https://github.com/Viola-Case/ROSE",
  "license": "BSD-3-Clause",
  "description": "Radical Open Software Engine",
  "builtin-baseline": "bc71aa640f89933294f16e004b212c7fd3183eed",
  "dependencies": [
    {
      "name": "sdl3",
      "features": ["vulkan"],
      "platform": "windows"
    },
    {
      "name": "sdl3",
      "features": [ "vulkan", "x11", "wayland"],
      "platform": "linux"
    },
    {
      "name": "sdl3-mixer",
      "features": [
        "libflac",
        "libvorbis",
        "mpg123",
        "opusfile",
        "wavpack"
      ]
    },
    {
      "name": "sdl3-ttf",
      "features": ["svg"]
    },
    {
      "name": "sdl3-image",
      "features": [
        "jpeg",
        "png",
        "tiff",
        "webp"
      ]
    },
    {
      "name": "imgui",
      "features": [
        "sdl3-binding", "opengl3-binding", "vulkan-binding", "sdl3-renderer-binding"
      ]
    },
    {
      "name": "glad",
      "features": ["gl-api-45"]
    },
    {
      "name": "spirv-cross"
    },
    {
      "name": "glslang",
      "features": [
        "opt",
        "tools"
      ]
    },
    {
      "name": "nlohmann-json",
      "features": []
    },
    {
      "name": "cli11"
    }

  ]
}
